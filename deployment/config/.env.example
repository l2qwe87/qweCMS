# MongoDB Configuration
MONGO_ROOT_USERNAME=qweadmin
MONGO_ROOT_PASSWORD=qweSecurePassword123!
MONGO_DATABASE=qwecms

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ISSUER=qweCMS
JWT_AUDIENCE=qweCMS-users
JWT_EXPIRATION_MINUTES=60

# Application Configuration
ASPNETCORE_ENVIRONMENT=Production
API_BASE_URL=http://localhost:5000
FRONTEND_BASE_URL=http://localhost

# Logging
LOG_LEVEL=Information
LOG_FILE_PATH=/app/logs/qwecms.log

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost:8080,http://localhost:4200

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/app/uploads

# Cache Configuration
CACHE_DURATION_MINUTES=30

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100